<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ShopApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VenkateshwaraPhotos">

        <activity android:name=".ui.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.OwnerDashboardActivity" android:exported="false" />
        <activity android:name=".ui.EmployeeDashboardActivity" android:exported="false" />
        <activity android:name=".ui.CategoryActivity" android:exported="false" />
        <activity android:name=".ui.ProductActivity" android:exported="false" />
        <activity android:name=".ui.VariantActivity" android:exported="false" />
        <activity android:name=".ui.InventoryActivity" android:exported="false" />
        <activity android:name=".ui.NewSaleActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.SalesHistoryActivity" android:exported="false" />
        <activity android:name=".ui.SaleDetailActivity" android:exported="false" />
        <activity android:name=".ui.PurchaseActivity" android:exported="false" />
        <activity android:name=".ui.ExpensesActivity" android:exported="false" />
        <activity android:name=".ui.ReportsActivity" android:exported="false" />
        <activity android:name=".ui.EmployeesActivity" android:exported="false" />
    </application>
</manifest>
